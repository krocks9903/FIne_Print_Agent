# Copy to .env / apps/web/.env.local — never commit real secrets.

# --- Model provider (server-only) ---
# mock = offline keyword matcher, no keys needed (default for onboarding, tests and CI)
# nrp | anthropic = live model; fill in the matching keys below
MODEL_PROVIDER=mock
NRP_BASE_URL=
NRP_API_KEY=
NRP_MODEL=gpt-oss
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Storage backend ---
# local  = JSON files under ./data (default for teammate onboarding, no cloud required)
# supabase = Postgres + Storage (production path; needs service role on server)
STORAGE_BACKEND=local
DEMO_OWNER_ID=00000000-0000-4000-8000-000000000001

# --- Supabase (required only when STORAGE_BACKEND=supabase) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Upload limits ---
MAX_UPLOAD_BYTES=5242880

# --- Google Calendar linking (optional; without these only the .ics download works) ---
# Google Cloud console > APIs & Services > Credentials > OAuth client ID (type: Web application).
# Authorized redirect URI: http://localhost:3000/api/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed when the app runs behind a proxy or on a domain other than the request's origin.
GOOGLE_REDIRECT_URI=
# 32 random bytes, base64. Encrypts stored calendar logins. Required in production;
# in development a key is generated under data/calendar if this is empty.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CALENDAR_TOKEN_KEY=
